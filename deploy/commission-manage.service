[Unit]
Description=CommissionManage web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=commission-manage
WorkingDirectory=/home/code/CommissionManage
Environment=COMMISSION_DB=/var/lib/commission-manage/studio.sqlite3
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/code/CommissionManage/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 5444
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
